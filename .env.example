# Salin file ini menjadi .env lalu isi sesuai 9router kamu.
# Semua nilai ini juga bisa diubah dari menu Pengaturan di aplikasi
# (disimpan di data/settings.json dan mengalahkan nilai di .env).

# Otak AI default-nya agent MCP (Claude Code / Codex yang standby lewat MCP server bwa).
# 9router bersifat opsional: set BWA_ENABLE_9ROUTER=1 untuk menampilkannya sebagai pilihan.
# (Aplikasi desktop tidak membaca .env: tambahkan "enable9router": true ke settings.json-nya.)
BWA_ENABLE_9ROUTER=0
# Sumber otak AI: mcp atau 9router (yang kedua hanya berlaku jika BWA_ENABLE_9ROUTER=1).
# Pengaturan 9router di bawah hanya dipakai dengan provider 9router.
BWA_PROVIDER=mcp
# (mode mcp) setelah Agent 3 membagi task, sesi otak: wait = lapor lalu tunggu perintah, auto = langsung kerjakan task
BWA_HANDOVER=wait

# Endpoint OpenAI-compatible dari 9router (pakai 127.0.0.1, bukan localhost, agar tidak nyasar ke IPv6)
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
# API key dari dashboard 9router (http://localhost:20128/dashboard). Kosongkan jika 9router tidak mewajibkan key.
NINEROUTER_API_KEY=
# Model default untuk ketiga agent. Bisa model (kr/claude-sonnet-4.5) atau nama combo 9router.
NINEROUTER_MODEL=kr/claude-sonnet-4.5

# (opsional) model khusus per agent; kosong = pakai NINEROUTER_MODEL
AGENT_IDEA_MODEL=
AGENT_TOPOLOGY_MODEL=
AGENT_TASKS_MODEL=

# (opsional) parameter generasi
NINEROUTER_TEMPERATURE=0.7
NINEROUTER_MAX_TOKENS=12000
# Timeout juga berlaku untuk mode mcp: batas waktu agent menjawab satu job setelah mengambilnya.
NINEROUTER_TIMEOUT_SEC=300

# Server BWA (API + UI build). Agent bridge (MCP/CLI) terhubung ke alamat ini.
PORT=3900
HOST=127.0.0.1
